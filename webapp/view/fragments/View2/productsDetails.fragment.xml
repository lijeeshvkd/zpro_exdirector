<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:forms="sap.ui.layout.form" >
    <ScrollContainer width="100%" vertical="true" focusable="true" >
        <Table id="idTblProductDetails" items="{ProductModel>/}" >
            <headerToolbar>
                <Toolbar>
                    <Title text="Products Details" />
                    <!-- Start: Attach001 -->
                    <Link text="Show Attachments" press="onShowAttachmentsLinkPress" />
                    <!-- End: Attach001 -->
                </Toolbar>
            </headerToolbar>
            <columns>
                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="6rem">
                    <Text text="Material Freight Groups" />
                </Column>
                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
                    <Text text="Product" />
                </Column>
                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
                    <Text text="Size" />
                </Column>
                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
                    <Text text="Designs" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" 
                    visible="{=${oRequestModel>/Vtweg} === '15' || ${oRequestModel>/Vtweg} === '19' || ${oRequestModel>/Vtweg} === '25' || ${oRequestModel>/Vtweg} === '29'  ? true: false}" >
                    <Text text="ORC(%)" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" 
                    visible="{=${oRequestModel>/Vtweg} === '15' || ${oRequestModel>/Vtweg} === '19' || ${oRequestModel>/Vtweg} === '25' || ${oRequestModel>/Vtweg} === '29'  ? false: true}" >
                    <Text text="ORC(Box)" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" >
                    <Text text="Quality" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End" >
                    <Text text="Part A/B/L" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End" >
                    <Text text="Total Volume" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End" >
                    <Text text="Current Volume" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
                    <Text text="Vendor" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" visible="false">
                    <Text text="Volume" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End" >
                    <Text text="Avg Bill Price-L3M_Region" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End" >
                    <Text text="Last Billed Price-L3M_Dealer" />
                </Column>

                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End" >
                    <Text text="Min Bill Price-L3M_Region" />
                </Column>

                <!-- <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
                    <Text text="Freight" />
                </Column> -->
                
                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
                    <Text text="Discount" />
                </Column>
                <Column minScreenWidth="Desktop" demandPopin="true" hAlign="Center" width="8rem">
                    <Text text="Net Ex Factory(Sqft)" />
                </Column>
                <Column minScreenWidth="Desktop" demandPopin="true" hAlign="Center" width="8rem">
                    <Text text="SVC/BP(Sqft)" />
                </Column>

                <Column minScreenWidth="Desktop" demandPopin="true" hAlign="Center" visible="false">
                    <Text text="Gross Margin" />
                </Column>
                <Column minScreenWidth="Desktop" demandPopin="true" hAlign="Center" visible="false">
                    <Text text="Volume(Sqft In Lakhs)" />
                </Column>

                <Column minScreenWidth="Desktop" demandPopin="true" hAlign="Center">
                    <Text text="Gross Margin(%)" />
                </Column>

                <Column minScreenWidth="Desktop" demandPopin="true" hAlign="Center">
                    <Text text="PMG Remarks" />
                </Column>
                <Column minScreenWidth="Desktop" demandPopin="true" hAlign="Center">
                    <Text text="NSH Remarks" />
                </Column>
                <Column minScreenWidth="Desktop" demandPopin="true" hAlign="Center">
                    <Text text="DH Remarks" />
                </Column>
                <Column minScreenWidth="Desktop" demandPopin="true" hAlign="Center" width="8rem" >
                    <Text text="ED Remarks" />
                </Column>
                <!-- End: Remarkcol001 -->
            </columns>

            <items>
                <ColumnListItem vAlign="Middle">
                    <cells>
                        <Text text="{ProductModel>Mfrgr}" />
                        <Text text="{ProductModel>Prdgrp}" />
                        <Text text="{ProductModel>Szcm}" />
                        <Text text="{ProductModel>Design}" />

                        <Text visible="{=${oRequestModel>/Vtweg} === '15' || ${oRequestModel>/Vtweg} === '19' || ${oRequestModel>/Vtweg} === '25' || ${oRequestModel>/Vtweg} === '29'  ? true: false}" text="{ProductModel>Commboxp}" />
                        <Text visible="{=${oRequestModel>/Vtweg} === '15' || ${oRequestModel>/Vtweg} === '19' || ${oRequestModel>/Vtweg} === '25' || ${oRequestModel>/Vtweg} === '29'  ? false: true}" text="{ProductModel>Commbox}" />

                        <Text text="{ProductModel>Zzprodh4}" />
                        <Text text="{ProductModel>Mvgr5}" />
                        <Text text="{ProductModel>Totalvolume}" />
                        <Text text="{ProductModel>CurVolFt}" />

                        <Text text="{ProductModel>Sname}" />

                        <Text visible="false" text="{ProductModel>Volume}" />
                        <Text text="{ProductModel>AvgBill}" />
                        <Text text="{ProductModel>LastBill}" />
                        <Text text="{ProductModel>MinBill}" />

                        <!-- <Text text="{ProductModel>Frghtsqft}" /> -->
                        <Text text="{parts:['ProductModel>Discount', 'ProductModel>Discountb'], formatter:'.formatter.getDiscount' }" />
                        <Text text="{ProductModel>Netexsqft}" />
                        <Text text="{ProductModel>Buyingpricesqft}" />
                    
                        <Text visible="false" text="{ProductModel>Grossmarg}" />
                        <Text visible="false" text="{ProductModel>Zvolumepft}" />
                        <Text text="{path:'ProductModel>Grossmargper'}" />
                        
                        <Text text="{path:'ProductModel>PmgRemarks'}" />
                        <Text text="{path:'ProductModel>NshRemarks'}" />
                        <Text text="{path:'ProductModel>DhRemarks'}" />
                        <TextArea value="{ProductModel>EdRemarkItem}" liveChange="onSbremarkTextAreaLiveChange"
                            editable="{= ${oRequestModel>/Status} === 'P' }" />
                        
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </ScrollContainer>
</core:FragmentDefinition>
